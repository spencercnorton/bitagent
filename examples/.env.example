# BitAgent — example env for the public-quickstart compose stack.
# Copy this file to `.env.public` and edit. Comments + blanks below
# are safe to leave; only POSTGRES_PASSWORD is required.

# --- REQUIRED ---

# Postgres password. Pick something long and random; this is the only
# thing standing between an attacker on the host and your database.
# Set a unique random password in your local copy before running Compose.
# Compose refuses to start while this required value is blank.
POSTGRES_PASSWORD=

# --- OPTIONAL: ports ---

# Host port for BitAgent's HTTP API (GraphQL / /metrics / /torznab /
# /import / /evidence/arr/*). Default 3333.
BITAGENT_HTTP_PORT=3333

# Host port for the BitTorrent peer protocol. Default 3334. Outbound-
# dominant; opening this inbound increases throughput but isn't
# required.
BITAGENT_PEER_PORT=3334

# --- OPTIONAL: dashboard ---

# The operator console and public library run inside the bitagent
# container as a supervised worker. true in this quickstart; the core's
# own default is false, so a headless crawler stays headless.
UI_ENABLED=true

# Host port for the dashboard. The compose binds it to 127.0.0.1
# because REQUIRE_AUTH is off below; put a reverse proxy in front
# before sharing it. Default 8080.
BITAGENT_UI_PORT=8080

# Which Host header serves which surface. Comma-separated, disjoint,
# non-empty; any other Host is answered 421. library.localhost resolves
# to loopback in Chrome/Firefox without configuration.
#   console: http://localhost:8080   library: http://library.localhost:8080
OPERATOR_HOSTS=localhost,127.0.0.1
PUBLIC_LIBRARY_HOSTS=library.localhost

# false = open dashboard (the development bypass). Never expose it
# like this. For a real deployment set DASHBOARD_API_KEY (scripts and
# curl) or a reverse proxy that performs the login — ui/README.md →
# Authentication lists the proxy tiers and their required proof.
REQUIRE_AUTH=false
DASHBOARD_API_KEY=

# --- OPTIONAL: classifier ---

# Free TMDB API key — content classifier uses it to enrich movie / TV
# torrents with title, year, episode metadata. Empty disables. Also
# read by the dashboard for posters.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- OPTIONAL: torznab ---

# Set this to require an api key on the /torznab feed URL. Empty
# leaves /torznab unauthenticated — fine on a tailnet / behind a
# reverse proxy, NOT fine on the open internet. Also read by the
# dashboard, whose /torznab proxy validates per-user keys against it.
TORZNAB_API_KEY=

# --- OPTIONAL: CSAM defense ---

# CSAM blocklist consumes community-shared lists of double-hashed
# (SHA-256-of-SHA-1) infohashes and rejects matches BEFORE any
# BEP-9 metadata fetch — closing the swarm-touching exposure window.
# See docs/csam-defense.md for the full architecture.
#
# Defaults: enabled with no feeds = NoOp; safe to leave unchanged
# until you find a feed you trust.
CSAM_BLOCKLIST_ENABLED=true
CSAM_BLOCKLIST_FEED_URLS=

# Self-export contributes this instance's post-fetch CSAM observations
# back into the community feed cycle. Local JSONL log on by default;
# outbound POST off by default (set the URL of a community collection
# endpoint to opt in).
CSAM_BLOCKLIST_EXPORT_ENABLED=true
CSAM_BLOCKLIST_EXPORT_UPSTREAM_URL=

# --- OPTIONAL: content filter ---

# Drop torrents whose title is non-English / non-Latin script / has
# blocked extensions / matches NSFW keywords. Two-stage opt-in:
# Enabled=true puts it in shadow mode (counterfactual metrics only);
# Enforce=true makes drops take effect.
CONTENT_FILTER_ENABLED=false
CONTENT_FILTER_ENFORCE=false

# --- OPTIONAL: retention ---

# Periodically delete torrents that haven't been seen in DHT
# announcements for a long time. ENABLED=true puts it in dry-run
# (would_purge counter only); ENABLE_PURGE=true actually deletes.
# Validate the would_purge trend before flipping ENABLE_PURGE.
RETENTION_ENABLED=false
RETENTION_ENABLE_PURGE=false

# --- OPTIONAL: tunables ---

# DHT crawler scaling factor. 1 is safe on a 4 GB host. Bump to 4-10
# on a beefier box; the crawler scales worker counts proportionally.
DHT_SCALING_FACTOR=1

# Log level. info is fine for steady-state; debug is loud.
LOG_LEVEL=info
